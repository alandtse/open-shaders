#pragma once

#include <string_view>

namespace Plugin
{
	using namespace std::literals;

	/// Full git describe string, e.g. "v1.4.11", "v1.4.11-3-gabcdef1", "v1.4.11-3-gabcdef1-dirty".
	/// Matches "v{VERSION}" exactly on a clean tagged release build.
	inline constexpr auto BUILD_DESCRIBE = "@GIT_DESCRIBE@"sv;

	/// Build branch, "*" for local (non-CI) builds; empty when detached.
	inline constexpr auto BUILD_BRANCH = "@GIT_BRANCH@"sv;

	/// Short commit hash of the build; empty when git was unavailable.
	inline constexpr auto BUILD_HASH = "@GIT_HASH@"sv;

	/// True when the working tree had uncommitted changes to tracked files at configure time.
	inline constexpr bool BUILD_DIRTY = @GIT_DIRTY@;
}
