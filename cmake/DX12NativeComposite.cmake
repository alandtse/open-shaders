# Native Composite uses the same DXC compiler and shader delivery as Native Scene.
if(NATIVE_SHADOW_DXC)
    set(DX12_VARIANT_DEPENDENCIES "${NATIVE_SHADER_SOURCE_ROOT}/package/Shaders/Common/NativeShadowQuality.hlsli")
    add_dx12_shadow_variants(NativeComposite "Native Composite" ShadowLayer.hlsl6 CompositeOffload.hlsl6 ShadowLayer CompositeOffload -Ges -Gis)
    set(_native_composite_dxil ${DX12_VARIANT_OUTPUTS})
    set(_native_composite_aio_dxil ${DX12_VARIANT_STAGED})
    add_custom_target(DX12NativeCompositeDXIL DEPENDS ${_native_composite_dxil})
    add_dependencies(${PROJECT_NAME} DX12NativeCompositeDXIL)
    if(DEFINED AIO_DIR)
        add_custom_target(DX12NativeCompositeAIO DEPENDS ${_native_composite_aio_dxil})
        add_dependencies(DX12NativeCompositeAIO DX12NativeCompositeDXIL)
        if(TARGET prepare_shaders)
            add_dependencies(DX12NativeCompositeAIO prepare_shaders)
        endif()
        if(TARGET PREPARE_AIO)
            add_dependencies(DX12NativeCompositeAIO PREPARE_AIO)
        endif()
    endif()
endif()
