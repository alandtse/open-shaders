{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://open-shaders.org/schemas/tree-wind-patches-v1.json",
    "title": "Open Shaders Tree Wind Patches",
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "trees"],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "version": {
            "const": 1
        },
        "trees": {
            "type": "array",
            "maxItems": 4096,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mesh"],
                "anyOf": [
                    {
                        "required": ["bendSensitivity"]
                    },
                    {
                        "required": ["leafAmbientSensitivity"]
                    }
                ],
                "properties": {
                    "mesh": {
                        "type": "string",
                        "maxLength": 260,
                        "pattern": "[.][nN][iI][fF]$"
                    },
                    "bendSensitivity": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 4.0
                    },
                    "leafAmbientSensitivity": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 4.0
                    },
                    "upperBendRange": {
                        "type": "number",
                        "minimum": 5.0,
                        "maximum": 100.0
                    },
                    "maximumDisplacementPercent": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 10.0
                    },
                    "trunkGustInfluence": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 2.0
                    },
                    "leafGustInfluence": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 2.0
                    }
                }
            }
        }
    }
}
