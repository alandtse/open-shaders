RaytracingAccelerationStructure Scene : register(t0);
Texture2D<float> RasterDepth : register(t1);
StructuredBuffer<float4> Lights : register(t2);
RWTexture2D<float4> RawMask : register(u0);

cbuffer ShadowInputs : register(b0)
{
    row_major float4x4 InverseProjection;
    row_major float4x4 InverseView;
    float4 PositionAdjust;
    uint2 Size;
    uint FrameIndex;
    uint DensityMode;
    uint LightCount;
    float MinDistance;
    float MaxDistance;
    uint Unused;
    uint EmitterSamples;
    float ShadowReachMultiplier;
    float ShadowFadeRange;
    float ShadowFalloffCurve;
    float NearLightRadius;
    uint NearLightExclusion;
    uint StochasticEmitterSampling;
    uint Padding;
    uint DebugGeometryMode;
};
#include "NativeTraceDensity.hlsli"

[numthreads(8, 8, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
    uint2 p = id.xy;
    if (any(p >= Size))
        return;
    if (DebugGeometryMode != 0u) {
        // Developer-only camera rays show triangles actually published to the TLAS.
        // This does not require any active lights, raster shadowing, or geometry texture.
        float2 clip = float2(2.0f * (float(p.x) + 0.5f) / float(Size.x) - 1.0f,
            1.0f - 2.0f * (float(p.y) + 0.5f) / float(Size.y));
        float4 viewSample = mul(InverseProjection, float4(clip, 0.5f, 1.0f));
        float4 camera = mul(InverseView, float4(0, 0, 0, 1));
        if (!all(isfinite(viewSample)) || abs(viewSample.w) < 1e-8f ||
            !all(isfinite(camera)) || abs(camera.w) < 1e-8f) {
            RawMask[p] = float4(0, 2, 0, 0);
            return;
        }
        float4 sceneSample = mul(InverseView, float4(viewSample.xyz / viewSample.w, 1));
        if (!all(isfinite(sceneSample)) || abs(sceneSample.w) < 1e-8f) {
            RawMask[p] = float4(0, 2, 0, 0);
            return;
        }
        float3 origin = camera.xyz / camera.w + PositionAdjust.xyz;
        float3 target = sceneSample.xyz / sceneSample.w + PositionAdjust.xyz;
        float3 direction = target - origin;
        float lengthSquared = dot(direction, direction);
        if (!isfinite(lengthSquared) || lengthSquared <= 1e-12f) {
            RawMask[p] = float4(0, 2, 0, 0);
            return;
        }
        RayDesc ray;
        ray.Origin = origin;
        ray.Direction = direction * rsqrt(lengthSquared);
        ray.TMin = 0.5f;
        ray.TMax = MaxDistance;
        const uint sourceMask = DebugGeometryMode == 2u ? 1u : DebugGeometryMode == 3u ? 2u : 3u;
        RayQuery<RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> geometryQuery;
        geometryQuery.TraceRayInline(Scene, RAY_FLAG_NONE, sourceMask, ray);
        while (geometryQuery.Proceed()) {}
        RawMask[p] = geometryQuery.CommittedStatus() == COMMITTED_TRIANGLE_HIT ?
            float4(1, 2, geometryQuery.CommittedRayT(), float(geometryQuery.CommittedInstanceID())) :
            float4(0, 2, 0, 0);
        return;
    }
    if (!NativeTraceDensityPixel(p.x, p.y, DensityMode, FrameIndex, 0x62c01daeu)) {
        RawMask[p] = float4(0, -1, 0, 0);
        return;
    }
    // 1: fully visible or no applicable light, 0: unsolved.
    RawMask[p] = float4(1, 0, 0, 0);
    float z = RasterDepth.Load(int3(p, 0));
    if (!isfinite(z) || z <= 0 || z >= 1)
        return;
    float2 clip = 2.0f * (float2(p) + 0.5f) / float2(Size) - 1.0f;
    clip.y = -clip.y;
    float4 v = mul(InverseProjection, float4(clip, z, 1));
    if (!all(isfinite(v)) || abs(v.w) < 1e-8f)
        return;
    float4 w = mul(InverseView, float4(v.xyz / v.w, 1));
    if (!all(isfinite(w)) || abs(w.w) < 1e-8f)
        return;
    float3 world = w.xyz / w.w + PositionAdjust.xyz;
    // Match open-RT's Native Composite contract: z is receiver distance,
    // not the hardware raster-depth sample used for position reconstruction.
    float receiverDistance = length(mul((float3x3)InverseView, v.xyz / v.w));
    if (!isfinite(receiverDistance) || receiverDistance <= 0)
        return;
    // Valid receiver with no applicable light: neutral, not an unsampled pixel.
    RawMask[p] = float4(1, 0, receiverDistance, 0);
    float total = 0, visible = 0;
    [loop] for (uint i = 0; i < min(LightCount, 64u); ++i) {
        float4 light = Lights[i * 3 + 0];    // xyz vanilla position + vanilla radius
        float4 radiance = Lights[i * 3 + 1]; // linear RGB + vanilla fade
        float4 params = Lights[i * 3 + 2];   // emitter radius + vanilla falloff + flags
        float3 delta = light.xyz - world;
        float d2 = dot(delta, delta);
        if (d2 <= MinDistance * MinDistance || !isfinite(d2))
            continue;
        float d = sqrt(d2);
        // Native reach is shadow-only; multiplier 1.0 preserves the light's vanilla radius.
        float radius = max(light.w * ShadowReachMultiplier, MinDistance);
        if (d >= radius)
            continue;
        float fraction = saturate(ShadowFadeRange);
        float fade = fraction <= 0.0f ? 1.0f :
            saturate((radius - d) / max(radius * fraction, 1e-4f));
        fade = fade * fade * (3.0f - 2.0f * fade);
        float gradualFalloff = fade <= 0.0f ? 0.0f : pow(fade, max(0.0f, ShadowFalloffCurve));
        float strength = dot(max(radiance.rgb, 0), float3(.2126, .7152, .0722));
        float weight = strength * max(0, radiance.a) * gradualFalloff /
            max(d2 + params.x * params.x, 1);
        if (weight <= 0 || !isfinite(weight))
            continue;

        float3 centerDirection = delta / d;
        float3 tangent = normalize(abs(centerDirection.z) < 0.99f ?
            cross(centerDirection, float3(0, 0, 1)) :
            cross(centerDirection, float3(0, 1, 0)));
        float3 bitangent = cross(centerDirection, tangent);
        uint sampleCount = StochasticEmitterSampling != 0u ? clamp(EmitterSamples, 1u, 16u) : 1u;
        float visibleSamples = 0.0f;
        uint seed = NativeDensityHash(p.x * 0x9e3779b9u ^ p.y * 0x85ebca6bu ^
                                      i * 0xc2b2ae35u);
        [loop] for (uint sample = 0u; sample < sampleCount; ++sample) {
            float3 target = light.xyz;
            if (StochasticEmitterSampling != 0u && params.x > 0.0f) {
                // Deterministic stratified emitter disk. Frame-independent so the
                // raw signal does not flicker without temporal accumulation.
                float u = frac((float(sample) + 0.5f) / float(sampleCount) +
                    float(seed & 65535u) / 65536.0f);
                float v = frac(float(sample) * 0.61803398875f +
                    float(seed >> 16u) / 65536.0f);
                float theta = v * 6.28318530718f;
                float diskRadius = sqrt(u) * max(params.x, 0.0f);
                target += (tangent * cos(theta) + bitangent * sin(theta)) * diskRadius;
            }

            float3 towardTarget = target - world;
            float targetDistance = length(towardTarget);
            if (!isfinite(targetDistance) || targetDistance <= MinDistance) {
                visibleSamples += 1.0f;
                continue;
            }
            float3 rayDirection = towardTarget / targetDistance;
            float tMax = min(targetDistance - MinDistance, MaxDistance);
            if (NearLightExclusion != 0u && NearLightRadius > 0.0f) {
                // Exclude occluders inside the sphere centered on the real light,
                // not around the camera or receiver. Solve ray/sphere entry.
                float projection = dot(delta, rayDirection);
                float discriminant = projection * projection -
                    (d2 - NearLightRadius * NearLightRadius);
                if (discriminant >= 0.0f)
                    tMax = min(tMax, projection - sqrt(discriminant) - MinDistance);
            }
            if (tMax <= MinDistance) {
                visibleSamples += 1.0f;
                continue;
            }
            RayDesc ray;
            ray.Origin = world + rayDirection * MinDistance;
            ray.Direction = rayDirection;
            ray.TMin = MinDistance;
            ray.TMax = tMax;
            RayQuery<RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> query;
            query.TraceRayInline(Scene, RAY_FLAG_NONE, 3, ray);
            while (query.Proceed()) {}
            visibleSamples += query.CommittedStatus() == COMMITTED_TRIANGLE_HIT ? 0.0f : 1.0f;
        }
        total += weight;
        visible += weight * (visibleSamples / float(sampleCount));
    }
    if (total > 1e-8f)
        RawMask[p] = float4(saturate(visible / total), 1, receiverDistance, total);
}
