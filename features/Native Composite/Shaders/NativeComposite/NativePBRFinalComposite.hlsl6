#include "NativePBRBRDF.hlsli"

// Material evaluation is independent of scene geometry. The final-color
// consumer is optional and uses native lights/TLAS only when both are ready.
Texture2D<float4> BaseOpacity : register(t0);
Texture2D<float4> NormalRoughness : register(t1);
Texture2D<float4> F0Metallic : register(t2);
Texture2D<float4> EmissionAO : register(t3);
Texture2D<uint> MaterialCoverage : register(t4);
Texture2D<float4> SurfaceDepthFacing : register(t5);
Texture2D<uint> NativeValidity : register(t6);

struct PointLight
{
    float4 positionRadius;
    float4 radianceSourceRadius;
    uint4 flags;
};
StructuredBuffer<PointLight> RawLights : register(t7);
RaytracingAccelerationStructure NativeScene : register(t8);
RWTexture2D<float4> SceneColor : register(u0);

cbuffer FinalComposite : register(b0)
{
    uint2 Size;
    uint LightCount;
    uint EnabledLobes;
    float3 CameraOrigin;
    float MinimumDistance;
    row_major float4x4 InverseProjection;
    row_major float4x4 InverseView;
    float4 LightTuning;
    float4 ShadowTuning;
    float DiffuseGain;
    float SpecularGain;
    float CompositeStrength;
    uint LegacyTransfer;
};

uint ShadowHash(uint value)
{
    value ^= value >> 16u; value *= 0x7feb352du;
    value ^= value >> 15u; value *= 0x846ca68bu;
    return value ^ (value >> 16u);
}

float3 SignedPower(float3 value, float exponent)
{
    return sign(value) * pow(abs(value), exponent);
}

// Uses the same unshaded 48-byte light records and falloff as NativeLighting.
// An opaque-caster ray query is conservative for the initial rigid opaque scope.
float3 DirectMaterialLighting(NativePBR::SurfaceMaterial material, float3 position,
    float3 viewDirection, uint2 pixel)
{
    float3 result = 0.0f;
    [loop] for (uint index = 0u; index < LightCount; ++index) {
        PointLight light = RawLights[index];
        if (light.flags.x == 0u) continue;
        float3 delta = light.positionRadius.xyz - position;
        float distance = length(delta);
        float radius = min(max(light.positionRadius.w * LightTuning.x, MinimumDistance), 60000.0f);
        if (!isfinite(distance) || distance <= MinimumDistance || distance >= radius) continue;
        float3 direction = delta / distance;
        if (dot(material.normal, direction) <= 0.0f) continue;

        float sourceRadius = max(light.radianceSourceRadius.w, MinimumDistance);
        float fade = saturate((radius - distance) / max(radius * LightTuning.y, MinimumDistance));
        float cutoff = fade * fade * (3.0f - 2.0f * fade);
        float attenuation = pow(cutoff, LightTuning.z) /
            max(distance * distance + sourceRadius * sourceRadius, 1e-4f);

        float3 visibilityTarget = light.positionRadius.xyz;
        if (ShadowTuning.z >= 0.5f && ShadowTuning.y > 0.0f) {
            float emitterRadius = min(sourceRadius * ShadowTuning.y, distance * 0.5f);
            if (emitterRadius > 0.0f) {
                uint seed = ShadowHash(pixel.x * 0x9e3779b9u ^ pixel.y * 0x85ebca6bu ^
                    index * 0x27d4eb2fu);
                float2 samplePoint = (float2(ShadowHash(seed ^ 0x68bc21ebu) >> 8u,
                    ShadowHash(seed ^ 0x02e5be93u) >> 8u) + 0.5f) / 16777216.0f;
                float angle = samplePoint.y * 6.28318530718f;
                float spread = emitterRadius * sqrt(samplePoint.x);
                float3 tangent = normalize(cross(abs(direction.z) < 0.9f ?
                    float3(0, 0, 1) : float3(0, 1, 0), direction));
                visibilityTarget += spread *
                    (cos(angle) * tangent + sin(angle) * cross(direction, tangent));
            }
        }

        RayDesc visibility;
        visibility.Origin = position + direction * MinimumDistance;
        float3 shadowDelta = visibilityTarget - visibility.Origin;
        float shadowLength = length(shadowDelta);
        visibility.Direction = shadowLength > MinimumDistance ?
            shadowDelta / shadowLength : direction;
        visibility.TMin = MinimumDistance;
        visibility.TMax = shadowLength - MinimumDistance;
        if (visibility.TMax <= visibility.TMin) continue;
        RayQuery<RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> shadow;
        shadow.TraceRayInline(NativeScene, RAY_FLAG_NONE, 3u, visibility);
        while (shadow.Proceed()) {}
        bool blocked = shadow.CommittedStatus() != COMMITTED_NOTHING;
        float visibilityScale = blocked ? 1.0f - saturate(ShadowTuning.x) : 1.0f;
        if (visibilityScale <= 0.0f) continue;

        float3 incoming = max(light.radianceSourceRadius.rgb, 0.0f) * attenuation * visibilityScale;
        NativePBR::DirectResponse response =
            NativePBR::EvaluateDirect(material, viewDirection, direction, incoming);
        if ((EnabledLobes & 1u) != 0u) result += response.diffuse * DiffuseGain;
        if ((EnabledLobes & 2u) != 0u) result += response.specular * SpecularGain;
    }
    return result * LightTuning.w * CompositeStrength;
}

[numthreads(8, 8, 1)]
void main(uint3 threadId : SV_DispatchThreadID)
{
    if (any(threadId.xy >= Size)) return;
    uint2 pixel = threadId.xy;
    if (MaterialCoverage[pixel] == 0u || NativeValidity[pixel] != 1u || LightCount == 0u)
        return;
    float4 base = BaseOpacity[pixel];
    float4 normal = NormalRoughness[pixel];
    float4 f0 = F0Metallic[pixel];
    float4 emission = EmissionAO[pixel];
    float depth = SurfaceDepthFacing[pixel].z;
    // Only the verified opaque static scope may replace final color.
    if (!all(isfinite(base)) || base.a < 0.999f ||
        !all(isfinite(normal)) || !all(isfinite(f0)) ||
        !all(isfinite(emission)) || !isfinite(depth) || depth <= 0.0f ||
        dot(normal.xyz, normal.xyz) <= 1e-8f)
        return;

    float2 clip = (float2(pixel) + 0.5f) * (2.0f / float2(Size)) - 1.0f;
    clip.y = -clip.y;
    float4 view = mul(InverseProjection, float4(clip, depth, 1.0f));
    if (!all(isfinite(view)) || abs(view.w) <= 1e-8f) return;
    float3 displacement = mul((float3x3)InverseView, view.xyz / view.w);
    if (!all(isfinite(displacement)) || dot(displacement, displacement) <= 1e-8f) return;
    float3 position = CameraOrigin + displacement;
    float3 viewDirection = normalize(-displacement);

    NativePBR::SurfaceMaterial material;
    material.baseColor = max(base.rgb, 0.0f);
    material.opacity = base.a;
    material.normal = normalize(normal.xyz);
    material.roughness = normal.w;
    material.f0 = saturate(f0.rgb);
    material.metallic = saturate(f0.a);
    material.emission = max(emission.rgb, 0.0f);
    material.ao = saturate(emission.a);

    float3 linearColor = DirectMaterialLighting(material, position, viewDirection, pixel);
    if ((EnabledLobes & 1u) != 0u)
        linearColor += material.emission * ShadowTuning.w;
    if (!all(isfinite(linearColor))) return;
    float4 original = SceneColor[pixel];
    original.rgb = LegacyTransfer != 0u ?
        SignedPower(linearColor, 1.0f / 1.6f) : linearColor;
    SceneColor[pixel] = original;
}
