Texture2D<float4> Diffuse : register(t0);
Texture2D<float4> Specular : register(t1);
Texture2D<uint> Validity : register(t2);
Texture2D<uint> EffectiveValidity : register(t3);
Texture2D<uint> RejectionReason : register(t4);
Texture2D<float4> LabGuide : register(t5);
Texture2D<float4> ReceiverGuide : register(t6);
Texture2D<float> RasterDepth : register(t7);
StructuredBuffer<float4> RasterCharacterBounds : register(t8);
RWTexture2D<float4> Scene : register(u0);
RWStructuredBuffer<uint> CompositeCounts : register(u1);
#include "ValidityPolicy.hlsli"
#include "RasterCharacter.hlsli"

cbuffer CompositeConstants : register(b0)
{
	uint2 Size;
	float Strength;
	uint LegacyTransfer;
	uint DiffusePolicy;
	uint SpecularPolicy;
	uint VisualMode;
	uint SpatialReconstruction;
	row_major float4x4 InverseProjection;
	row_major float4x4 InverseView;
    uint CharacterCount;
    float CharacterNativeBlend;
    uint CharacterDebug;
};

float3 SignedPower(float3 value, float exponent)
{
	return sign(value) * pow(abs(value), exponent);
}


float ReceiverDistance(uint2 pixel)
{
    float depth = RasterDepth[pixel];
    if (!isfinite(depth)) return -1.0f;
    float2 clip = (float2(pixel) + 0.5f) * (2.0f / float2(Size)) - 1.0f;
    clip.y = -clip.y;
    float4 view = mul(InverseProjection, float4(clip, depth, 1.0f));
    if (!all(isfinite(view)) || abs(view.w) <= 1e-8f) return -1.0f;
    float3 direction = mul((float3x3)InverseView, view.xyz / view.w);
    float distance = length(direction);
    return isfinite(distance) && distance > 0.0f ? distance : -1.0f;
}
bool ValidDirectNeighbor(uint2 pixel, float targetDistance, out float4 guide)
{
    guide = ReceiverGuide[pixel];
    if (!all(isfinite(guide)) || guide.w <= 0.0f || dot(guide.xyz, guide.xyz) <= 1e-8f) return false;
    uint reason = RejectionReason[pixel];
    if ((reason & 0x10000000u) != 0u) return false;
    uint original = Validity[pixel], effective = EffectiveValidity[pixel];
    if (!AcceptContribution(DiffusePolicy, original, effective, reason) &&
        !AcceptContribution(SpecularPolicy, original, effective, reason)) return false;
    float distance = ReceiverDistance(pixel);
    return distance > 0.0f && abs(distance - targetDistance) <= max(5.0f, targetDistance * 1e-5f);
}
bool ReconstructDirect(uint2 pixel, out float3 diffuse, out float3 specular,
    out bool diffuseAccepted, out bool specularAccepted)
{
    diffuse = 0.0f; specular = 0.0f;
    diffuseAccepted = false; specularAccepted = false;
    float targetDistance = ReceiverDistance(pixel);
    if (targetDistance <= 0.0f) return false;
    float4 reference = 0.0f;
    int radiusUsed = 0;
    float nearestScore = 1e30f;
    [loop] for (int radius = 1; radius <= 2 && reference.w == 0.0f; ++radius) {
        [loop] for (int dy = -radius; dy <= radius; ++dy) {
            [loop] for (int dx = -radius; dx <= radius; ++dx) {
                int2 p = int2(pixel) + int2(dx, dy);
                if (any(p < 0) || any(p >= int2(Size))) continue;
                float4 guide;
                if (!ValidDirectNeighbor(uint2(p), targetDistance, guide)) continue;
                float distance = ReceiverDistance(uint2(p));
                float score = float(dx * dx + dy * dy) + 0.1f * abs(distance - targetDistance);
                if (score < nearestScore) {
                    nearestScore = score;
                    reference = guide;
                    radiusUsed = radius;
                }
            }
        }
    }
    if (reference.w <= 0.0f) return false;
    float diffuseWeight = 0.0f, specularWeight = 0.0f;
    [loop] for (int dy = -radiusUsed; dy <= radiusUsed; ++dy) {
        [loop] for (int dx = -radiusUsed; dx <= radiusUsed; ++dx) {
            int2 p = int2(pixel) + int2(dx, dy);
            if (any(p < 0) || any(p >= int2(Size))) continue;
            float4 guide;
            if (!ValidDirectNeighbor(uint2(p), targetDistance, guide) ||
                guide.w != reference.w || dot(normalize(guide.xyz), normalize(reference.xyz)) < 0.85f) continue;
            uint original = Validity[uint2(p)], effective = EffectiveValidity[uint2(p)], reason = RejectionReason[uint2(p)];
            float weight = rcp(1.0f + float(dx * dx + dy * dy));
            float3 d = Diffuse[uint2(p)].rgb, sp = Specular[uint2(p)].rgb;
            if (AcceptContribution(DiffusePolicy, original, effective, reason) && all(isfinite(d))) {
                diffuse += d * weight; diffuseWeight += weight;
            }
            if (AcceptContribution(SpecularPolicy, original, effective, reason) && all(isfinite(sp))) {
                specular += sp * weight; specularWeight += weight;
            }
        }
    }
    diffuseAccepted = diffuseWeight > 0.0f;
    specularAccepted = specularWeight > 0.0f;
    if (diffuseAccepted) diffuse /= diffuseWeight;
    if (specularAccepted) specular /= specularWeight;
    return diffuseAccepted || specularAccepted;
}

[numthreads(8, 8, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
	if (any(id.xy >= Size)) return;
	uint original = Validity[id.xy], effective = EffectiveValidity[id.xy], reason = RejectionReason[id.xy];
	float4 guide = LabGuide[id.xy];
	float3 diffuse = Diffuse[id.xy].rgb, specular = Specular[id.xy].rgb;
	bool strict = original == 1, accepted = effective == 1;
	if (VisualMode != 0) {
		InterlockedAdd(CompositeCounts[2], 1);
		float3 display = 0;
		if (VisualMode == 1) display = original == 1 ? float3(0, 1, 0) : original == 2 ? float3(0, 1, 1) : original == 3 ? float3(1, 0, 1) : 0;
		else if (VisualMode == 2) display = effective == 1 ? float3(0, 1, 0) : effective == 2 ? float3(0, 1, 1) : effective == 3 ? float3(1, 0, 1) : 0;
		else if (VisualMode == 3) display = (reason & 0x80000000u) != 0 ? float3(1, 0, 1) : 0;
		else if (VisualMode == 4) {
			uint r = reason & 255u;
			display = r == 1 ? float3(1, 0, 0) : r == 2 ? float3(0.4, 0, 0) : r == 3 ? float3(1, 0.5, 0) :
				r == 4 ? float3(1, 0, 1) : r == 5 ? float3(0.5, 0, 1) : r == 6 ? float3(0, 0, 1) :
				r == 7 ? float3(1, 1, 0) : r == 8 ? float3(1, 1, 1) : r == 9 ? float3(0, 1, 1) : r == 10 ? float3(0, 1, 0) : 0;
		} else if (VisualMode == 5) display = guide.x.xxx;
		else if (VisualMode == 6) display = guide.x > 0 ? saturate(log2(1 + guide.y) / 16).xxx : 0;
		else if (VisualMode == 7) display = guide.w == 0 ? float3(1, 0, 1) : guide.w == 2 ? float3(0, 1, 1) : guide.w == 3 ? float3(1, 1, 0) : guide.w == 4 ? float3(1, 0.5, 0) : float3(1 - saturate(guide.z), saturate(guide.z), 0);
		else if (VisualMode == 8) display = all(isfinite(diffuse)) ? saturate(diffuse) : float3(1, 0, 1);
		else if (VisualMode == 9) display = all(isfinite(specular)) ? saturate(specular) : float3(1, 0, 1);
		else if (VisualMode == 10) {
			float3 difference = abs((accepted ? diffuse + specular : 0) - (strict ? diffuse + specular : 0));
			float magnitude = all(isfinite(difference)) ? saturate(max(difference.r, max(difference.g, difference.b)) * Strength) : 1;
			display = strict == accepted ? 0 : magnitude * (accepted ? float3(0, 1, 1) : float3(1, 0.5, 0));
		}
		float4 originalColor = Scene[id.xy];
		Scene[id.xy] = float4(display, originalColor.a);
		return;
	}
    const bool characterReceiver = IsRasterCharacterReceiver(
        id.xy, RasterDepth[id.xy], Size, InverseProjection, InverseView, CharacterCount);
    if (CharacterDebug != 0u) {
        float4 preserved = Scene[id.xy];
        Scene[id.xy] = float4(characterReceiver ? float3(1,0,1) : float3(0,0,0), preserved.a);
        return;
    }
    if (characterReceiver && CharacterNativeBlend <= 0.001f) return;
	bool acceptDiffuse = AcceptContribution(DiffusePolicy, original, effective, reason) && all(isfinite(diffuse));
	bool acceptSpecular = AcceptContribution(SpecularPolicy, original, effective, reason) && all(isfinite(specular));
	if (SpatialReconstruction != 0u && (reason & 0x10000000u) != 0u) {
		bool reconstructedDiffuse, reconstructedSpecular;
		if (ReconstructDirect(id.xy, diffuse, specular, reconstructedDiffuse, reconstructedSpecular)) {
			acceptDiffuse = reconstructedDiffuse;
			acceptSpecular = reconstructedSpecular;
			InterlockedAdd(CompositeCounts[5], 1);
		}
	}
	if (acceptDiffuse || acceptSpecular) InterlockedAdd(CompositeCounts[0], 1);
	if ((acceptDiffuse || acceptSpecular) && original != 1 && effective == 1) InterlockedAdd(CompositeCounts[3], 1);
	if ((acceptDiffuse || acceptSpecular) && original != 1 && effective != 1) InterlockedAdd(CompositeCounts[4], 1);
	float3 lighting = ((acceptDiffuse ? diffuse : 0) + (acceptSpecular ? specular : 0)) *
        (characterReceiver ? saturate(CharacterNativeBlend) : 1.0f);
	if (!all(isfinite(lighting)) || !any(lighting != 0))
		return;
	InterlockedAdd(CompositeCounts[1], 1);
	float4 color = Scene[id.xy];
	float3 linearColor = LegacyTransfer != 0 ? SignedPower(color.rgb, 1.6) : color.rgb;
	linearColor += lighting * Strength;
	color.rgb = LegacyTransfer != 0 ? SignedPower(linearColor, 1.0 / 1.6) : linearColor;
	Scene[id.xy] = color;
}
