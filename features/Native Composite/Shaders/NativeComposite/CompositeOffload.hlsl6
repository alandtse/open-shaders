Texture2D<float4> ShadowMask : register(t0);
Texture2D<float> RasterDepth : register(t1);
RWTexture2D<float4> Scene : register(u0);

cbuffer ShadowConstants : register(b0)
{
	uint2 Size;
	float ReceiverTolerance;
	float RadiusUnused;
	uint LegacyTransfer;
	uint PublishUnused;
	float StrengthUnused;
	float BlendUnused;
	row_major float4x4 InverseProjection;
	row_major float4x4 InverseView;
	uint SpatialUnused;
	uint GridUnused;
	uint2 LogicalSize;
};

#ifndef NATIVE_SHADOW_QUALITY
#define NATIVE_SHADOW_QUALITY 0
#endif

#include "Common/NativeShadowQuality.hlsli"
bool ValidMask(float4 mask)
{
	return all(isfinite(mask)) && mask.y == 1.0f && mask.z > 0.0f && mask.w > 0.0f;
}

#if NATIVE_SHADOW_QUALITY == 2
bool ReceiverSample(float4 mask)
{
	return all(isfinite(mask)) && mask.z > 0.0f &&
	       (ValidMask(mask) || (mask.y == 0.0f && mask.w == 0.0f));
}
#endif

[numthreads(8, 8, 1)] void main(uint3 id : SV_DispatchThreadID)
{
	if (any(id.xy >= Size))
		return;
#if NATIVE_SHADOW_QUALITY == 0
	const float4 center = ShadowMask[id.xy];
	if (!ValidMask(center))
		return;
#else
	const uint2 logical = id.xy / 2u;
	const float4 center = ShadowMask[logical];
	const bool sampled = all(id.xy == min(logical * 2u + 1u, Size - 1u));
	if (sampled && !ValidMask(center))
		return;
#endif
	const float depth = RasterDepth[id.xy];
	if (!isfinite(depth) || depth <= 0.0f || depth >= 1.0f)
		return;
	float2 clip = (float2(id.xy) + 0.5f) * (2.0f / float2(Size)) - 1.0f;
	clip.y = -clip.y;
	const float4 view = mul(InverseProjection, float4(clip, depth, 1.0f));
	if (!all(isfinite(view)) || abs(view.w) <= 1e-8f)
		return;
	const float distance = length(mul((float3x3)InverseView, view.xyz / view.w));
	if (!isfinite(distance) || distance <= 0.0f)
		return;
	const float tolerance = max(ReceiverTolerance, distance * 1e-5f);
	float visibility;
#if NATIVE_SHADOW_QUALITY == 0
	if (abs(center.z - distance) > tolerance)
		return;
	visibility = saturate(center.x);
#else
	if (sampled) {
		if (abs(center.z - distance) > tolerance)
			return;
		visibility = saturate(center.x);
	} else {
		const int2 origin = int2(logical) - int2((id.x & 1u) == 0u ? 1 : 0, (id.y & 1u) == 0u ? 1 : 0);
		float weighted = 0.0f, total = 0.0f;
		[unroll] for (int y = 0; y < 2; ++y) {
			[unroll] for (int x = 0; x < 2; ++x) {
				const int2 neighbor = origin + int2(x, y);
				if (any(neighbor < 0) || any(neighbor >= int2(LogicalSize)))
					continue;
				const float4 sample = ShadowMask[uint2(neighbor)];
				if (!ReceiverSample(sample) || abs(sample.z - distance) > tolerance)
					continue;
				const float2 delta = float2(min(uint2(neighbor) * 2u + 1u, Size - 1u)) - float2(id.xy);
				const float weight = rcp(1.0f + dot(delta, delta));
				weighted += saturate(sample.x) * weight;
				total += weight;
			}
		}
		if (total <= 0.0f)
			return;
		visibility = weighted / total;
	}
#endif
	const float layer = 1.0f - (1.0f - visibility) * kOffloadingBlend;
	if (layer >= 1.0f)
		return;
	float4 color = Scene[id.xy];
	if (!all(isfinite(color.rgb)))
		return;
	color.rgb *= LegacyTransfer != 0u ? pow(layer, 1.0f / 1.6f) : layer;
	Scene[id.xy] = color;
}
