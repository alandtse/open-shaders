Texture2D<float4> RasterColor : register(t0);
Texture2D<float> ShadowMask : register(t1);
RWTexture2D<float4> CompositeColor : register(u0);

cbuffer Composite : register(b0)
{
	uint2 Size;
	float Strength;
	float Padding;
};

[numthreads(8, 8, 1)]
void main(uint3 dispatchThread : SV_DispatchThreadID)
{
	uint2 pixel = dispatchThread.xy;
	if (any(pixel >= Size))
		return;
	const float visibility = saturate(ShadowMask.Load(int3(pixel, 0)));
	const float4 color = RasterColor.Load(int3(pixel, 0));
	CompositeColor[pixel] = float4(color.rgb * lerp(1.0, visibility, Strength), color.a);
}
