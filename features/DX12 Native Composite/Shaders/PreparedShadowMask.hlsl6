RaytracingAccelerationStructure StaticScene : register(t0);
Texture2D<float> SceneDepth : register(t1);

struct PreparedLight
{
	float4 positionRadius;
	float4 colorFade;
};
StructuredBuffer<PreparedLight> Lights : register(t2);
RWTexture2D<float> ShadowMask : register(u0);

cbuffer Camera : register(b0)
{
	row_major float4x4 ProjectionInverse;
	row_major float4x4 ViewInverse;
	float4 CameraAdjust;
	uint2 Size;
	uint LightCount;
	float Padding;
};

[numthreads(8, 8, 1)]
void main(uint3 dispatchThread : SV_DispatchThreadID)
{
	uint2 pixel = dispatchThread.xy;
	if (any(pixel >= Size))
		return;
	const float depth = SceneDepth.Load(int3(pixel, 0));
	const float2 uv = (float2(pixel) + 0.5) / float2(Size);
	float4 view = mul(ProjectionInverse, float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0));
	if (abs(view.w) < 1e-6) {
		ShadowMask[pixel] = 1.0;
		return;
	}
	view /= view.w;
	const float3 receiver = mul(ViewInverse, float4(view.xyz, 1.0)).xyz + CameraAdjust.xyz;
	float visibleWeight = 0.0;
	float totalWeight = 0.0;
	[loop]
	for (uint index = 0; index < LightCount; ++index) {
		const PreparedLight light = Lights[index];
		const float3 offset = light.positionRadius.xyz - receiver;
		const float distance = length(offset);
		const float radius = light.positionRadius.w;
		if (distance <= 4.0 || distance >= radius)
			continue;
		const float range = saturate(1.0 - distance / radius);
		const float energy = max(dot(light.colorFade.rgb, float3(0.2126, 0.7152, 0.0722)) * light.colorFade.a, 0.0);
		const float weight = range * range * energy;
		if (weight < 0.001)
			continue;
		totalWeight += weight;
		RayDesc ray;
		ray.Direction = offset / distance;
		ray.Origin = receiver + ray.Direction * 2.0;
		ray.TMin = 0.0;
		ray.TMax = distance - 4.0;
		RayQuery<RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> query;
		query.TraceRayInline(StaticScene, RAY_FLAG_NONE, 1, ray);
		while (query.Proceed()) {}
		if (query.CommittedStatus() == COMMITTED_NOTHING)
			visibleWeight += weight;
	}
	ShadowMask[pixel] = totalWeight > 0.001 ? saturate(visibleWeight / totalWeight) : 1.0;
}
